# 서버 전용 비밀키입니다. 실제 키를 저장소에 커밋하지 마세요.
# 비워두어도 서버와 정확한 검사코드 검색은 제한 모드로 실행됩니다.
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_EMBEDDING_BATCH_SIZE=5
GEMINI_EMBEDDING_REQUEST_DELAY_MS=15000
GEMINI_EMBEDDING_REQUEST_TIMEOUT_MS=30000
GEMINI_EMBEDDING_MAX_RETRIES=3
GEMINI_EMBEDDING_BUILD_QUOTA_RETRY_DELAY_MS=60000

GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_GENERATION_REQUEST_TIMEOUT_MS=30000
GEMINI_GENERATION_MAX_RETRIES=2

RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.60

CHATBOT_HOST=127.0.0.1
CHATBOT_PORT=3002
CHATBOT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 비워두면 Vite 개발 proxy(/api -> 127.0.0.1:3002)를 사용합니다.
VITE_CHATBOT_API_URL=

# Vite 개발 프록시용 서버 주소입니다. 브라우저 번들에는 포함되지 않습니다.
CHATBOT_PROXY_TARGET=http://127.0.0.1:3002
